# 1. MySQL Relational Database Configuration
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=railway_db

# 2. MongoDB Atlas NoSQL Database Configuration (Free Tier M0 Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=railway_nosql_db

# Razorpay Test Mode Credentials (Optional: Leave blank for automatic high-fidelity test simulator)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
